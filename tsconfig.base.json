{
	"compilerOptions": {
		"strict": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"jsx": "react-jsx",
		"moduleResolution": "node",
		"target": "ES2021",
		"baseUrl": "./",
		"paths": {
			"shared/*": ["./shared/*"],
			"backend/*": ["./backend/*"],
			"frontend/*": ["./frontend/*"]
		}
	}
}
